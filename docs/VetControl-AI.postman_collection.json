    {
      "name": "1. Citas (Ep3-Hu10)",
      "item": [
        {
          "name": "Crear cita (propietario) -> nace «programada» (la «solicitada» de los criterios)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_mascota\": 1,\n  \"id_veterinario\": 1,\n  \"fecha_hora\": \"{{fechaCita}}\",\n  \"duracion_min\": 30,\n  \"motivo\": \"Vacuna anual\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Una fecha futura distinta en cada ejecución (a una hora en punto, entre 7 y 400 días)",
                  "const dias = 7 + Math.floor(Math.random() * 390);",
                  "const f = new Date(Date.now() + dias * 86400000);",
                  "f.setUTCHours(15, 0, 0, 0);",
                  "pm.collectionVariables.set('fechaCita', f.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test('Estado inicial programada', () => pm.expect(c.estado).to.eql('programada'));",
                  "pm.collectionVariables.set('idCita', c.id_cita);"
                ]
              }
            }
          ]
        },
